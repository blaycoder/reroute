// Storage mirror of src/types. Structured fields that SQLite can't express
// natively (JSON shapes, enums) are stored as serialized JSON strings or
// plain strings — same shape works when the target flips to Postgres.
// There is no Question table: the question bank is code
// (src/data/question-bank.ts), so answer keys never live in the database and
// there is nothing to seed. Attempt.questionId is therefore a plain string —
// attempts must survive question edits.
//
// SQLite's PSL target cannot generate ids or hold Boolean yet, so ids are
// assigned by the app (newId() in src/lib/db.ts) and booleans are stored as
// Int 0/1.

model Student {
  id            String              @id
  name          String?
  targetExam    String              @default("JAMB")
  targetScore   Int
  subjects      String // JSON array
  createdAt     DateTime            @default(now())
  attempts      Attempt[]
  interventions Intervention[]
  profile       LearnerProfile?
  sessions      DiagnosticSession[]
}

// One real diagnostic run. Everything the fingerprint shows is computed from
// the Attempt rows that belong to a session — there is no seeded state.
model DiagnosticSession {
  id                 String    @id
  studentId          String
  student            Student   @relation(fields: [studentId], references: [id])
  subject            String
  startedAt          DateTime  @default(now())
  completedAt        DateTime?
  completedInSeconds Int?
  attempts           Attempt[]
}

model Attempt {
  id                    String            @id
  studentId             String
  student               Student           @relation(fields: [studentId], references: [id])
  diagnosticId          String
  session               DiagnosticSession @relation(fields: [diagnosticId], references: [id])
  interventionId        String? // set for practice / reassessment attempts
  questionId            String
  purpose               String // 'diagnostic' | 'practice' | 'reassessment'
  selectedOption        String? // null when the timer ran out with nothing chosen
  correct               Int // 0 | 1
  responseTimeSeconds   Int
  inferredConfidence    String // Confidence
  inferredMasterySignal String // 'up' | 'slight-up' | 'flag' | 'gap'
  telemetryJson         String // AttemptTelemetry
  diagnosisJson         String? // AIDiagnosis, filled in when a diagnostic completes
  createdAt             DateTime          @default(now())

  @@index([studentId])
  @@index([diagnosticId])
}

// Computed cache of the learner's profile, rebuilt from attempts by
// computeLearnerProfile() — never written from a fixture.
model LearnerProfile {
  id                String   @id
  studentId         String   @unique
  student           Student  @relation(fields: [studentId], references: [id])
  overallJson       String // LearnerState['learnerProfile']['overall']
  byTopicJson       String // Record<string, TopicProfile>
  headlineDiagnosisJson String? // HeadlineDiagnosis | null
  readinessIndex    Int
  profileConfidence Float
  updatedAt         DateTime @default(now())
}

model Intervention {
  id            String    @id
  studentId     String
  student       Student   @relation(fields: [studentId], references: [id])
  topic         String
  actionType    String // NextAction
  contentJson   String // StoredIntervention (src/lib/intervention-content.ts)
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  masteryBefore Float
  masteryAfter  Float?
  improved      Int? // 0 | 1

  @@index([studentId])
}
