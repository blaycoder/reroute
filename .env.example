# PostgreSQL connection string (Prisma Postgres, or any Postgres).
#
#   Local + migrations (emit, db init, migrate): the DIRECT string.
#     Prisma Console -> your database -> "Connect to your database" ->
#     "Generate new connection string" -> copy the direct one.
#     postgres://USER:PASSWORD@db.prisma.io:5432/?sslmode=require
#
#   Vercel (production): set DATABASE_URL in Project Settings -> Environment
#   Variables to the POOLED string instead (host pooled.db.prisma.io). Serverless
#   functions open many short-lived connections; the direct string exhausts them.
#
# Keep it secret: never commit .env or paste this value anywhere public.
DATABASE_URL=""

# LLM provider — fill in whichever you use for the AI diagnosis. Optional: with
# no key the diagnosis falls back to the question's stored misconception.
OPENAI_API_KEY=""
ZHIPU_API_KEY=""
