# SQLite database file for local dev (Prisma 8 takes a plain path, not a
# `file:` URL). Defaults to ./db/reroute.db when unset.
# Prod: the SQLite target does not persist on serverless hosts — production
# needs the Postgres target (@prisma/orm-postgres), which addresses models as
# `db.orm.public.<Model>`. See the README's Prisma 8 section.
SQLITE_PATH="./db/reroute.db"

# LLM provider — fill in whichever you use for intervention generation.
OPENAI_API_KEY=""
ZHIPU_API_KEY=""
